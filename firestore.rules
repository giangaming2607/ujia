rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global safety net - default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Exam subjects and schedules
    match /subjects/{subjectId} {
      allow read, write: if true;
    }

    // 3. Questions per subject
    match /subjects/{subjectId}/questions/{questionId} {
      allow read, write: if true;
    }

    // 4. Students real-time activities and monitoring profiles
    match /students/{studentId} {
      allow read, write: if true;
    }

    // 5. Exam attempts and results
    match /exams/{examId} {
      allow read, write: if true;
    }
  }
}
